# Nebra ROCK Pi 4 Indoor: Radxa ROCK Pi 4 (RK3399) + mPCIe concentrator (SX1301 or SX1302).
# Being set up (2026-11-09), see nebra-rockpi4.md. Unit: ROCK Pi 4 Plus v1.73 (OP1 SoC, soldered eMMC; same 40-pin header as ROCK Pi 4).
# Values from NebraLtd/hm-pyhelper hardware_definitions.py ("nebra-indoor2").
NEON_DEVICE="Nebra ROCK Pi 4 Indoor"
# Armbian's name for the header's SPI1 with the spidev overlay (balenaOS called it
# /dev/spidev32766.0) (verify): install.sh tries every /dev/spidev* for an SX1302 anyway;
# this one is the SX1301 build's. Run `ls /dev/spidev*` on the board.
NEON_SPI=/dev/spidev1.0
# The concentrator's chip once known from the diagnostic (nebra-rockpi4.md): sx1302 or sx1301.
# Unset, a failed SX1302 reset builds the SX1301 forwarder instead (set it after the diagnostic).
#NEON_CHIP=sx1302
# Reset is sysfs GPIO 149 on kernels with fixed GPIO numbering = GPIO4_C5,
# i.e. bank gpio4 (address ff790000), line 21.
NEON_RESET_GPIO_CHIP=ff790000
NEON_RESET_GPIO_LINE=21
# ECC608 secure element (former Helium key): I2C bus 7, address 0x60, slot 0.
NEON_ECC_I2C_BUS=7
