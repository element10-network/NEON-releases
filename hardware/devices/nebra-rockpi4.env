# Nebra ROCK Pi 4 Indoor: Radxa ROCK Pi 4 (RK3399) + mPCIe concentrator (SX1301 or SX1302).
# On hold, see nebra-rockpi4.md. Unit: ROCK Pi 4 Plus v1.73 (OP1 SoC, soldered eMMC; same 40-pin header as ROCK Pi 4).
# Values from NebraLtd/hm-pyhelper hardware_definitions.py ("nebra-indoor2").
NEON_DEVICE="Nebra ROCK Pi 4 Indoor"
# Name under Nebra's balenaOS. Other OS images number SPI buses differently:
# run `ls /dev/spidev*` and set the one the concentrator answers on.
NEON_SPI=/dev/spidev32766.0
# Reset is sysfs GPIO 149 on kernels with fixed GPIO numbering = GPIO4_C5,
# i.e. bank gpio4 (address ff790000), line 21.
NEON_RESET_GPIO_CHIP=ff790000
NEON_RESET_GPIO_LINE=21
# ECC608 secure element (former Helium key): I2C bus 7, address 0x60, slot 0.
NEON_ECC_I2C_BUS=7
