[Unit]
Description=Neon: post the electrode's new epoch roots with the admin key (home)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The user that holds the admin key (ne on hq, the owner's Pi), not root. Its SSH key may do nothing on
# the electrode but this (neon-epoch-remote.sh; and read the world scanner's packets for the vault's screen).
User=ne
Group=ne
NoNewPrivileges=yes
PrivateTmp=yes
# Where neon-token keeps the hub history it read (finalized: never changes): each run reads only
# what is new, however many transactions others add naming the hub accounts (review 2026-11-18).
CacheDirectory=neon-post
ProtectSystem=full
ProtectHome=read-only
ExecStart=/bin/sh /opt/neon-post/neon-post.sh
# 75: another run was going (this one did nothing, and is not recorded as the last run).
SuccessExitStatus=75
# When it ended and how, kept in /var/lib/neon-post/last-run (systemd forgets it at a restart).
ExecStopPost=/bin/sh /opt/neon-post/neon-post.sh --record-run
