# neond settings (US915). Log level: info, or debug to see every received packet.
RUST_LOG=info
# The starting preset; it must match the local mesh. install.sh sets it, the panel can change it.
# The default channel is named after it.
NEON_PRESET=LongFast
# Add --channel NAME:BASE64_PSK (repeatable) to decode other channels instead.
# Receive only. To test transmitting, use the second line instead.
# The beacon text must not contain spaces: systemd splits NEOND_ARGS on whitespace.
NEOND_ARGS=
#NEOND_ARGS=--beacon-text Hello-from-Neon --beacon-interval 300 --tx-freq 906.875 --tx-power 14
# Relay (rebroadcast) mesh traffic, limited to --duty-cycle percent of airtime per hour (default 10):
#NEOND_ARGS=--relay --tx-freq 906.875 --tx-power 14
# Relay and bridge to the public Meshtastic MQTT server (uplink only; add --mqtt-downlink to transmit MQTT traffic):
#NEOND_ARGS=--relay --tx-freq 906.875 --tx-power 14 --mqtt mqtt.meshtastic.org --mqtt-root msh/US
# Relay and join the Neon backbone (station key in /opt/neon/station.key, TCP port 4001):
#NEOND_ARGS=--relay --tx-freq 906.875 --tx-power 14 --backbone --region US
# The web panel on port 8080: set the password in its first-run setup page (or Settings), not here.
#NEOND_ARGS=--web 0.0.0.0:8080
